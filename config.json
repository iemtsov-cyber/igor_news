{
  "version": 9,
  "timezone": "Europe/Moscow",
  "lookback_hours": 8,
  "edition": {
    "target_items": 15,
    "min_items": 0,
    "max_items": 15,
    "show_links": false,
    "show_source_names": false,
    "show_section_headers": true,
    "max_politics_share": 0.15,
    "max_items_from_one_source": 4,
    "max_reddit_items": 2,
    "max_meme_items": 1,
    "min_internet_elements_per_day": 1,
    "random_top_items_per_update": 0
  },
  "models": {
    "collector": "rss",
    "editor": "google/gemma-4-31b-it:free"
  },
  "web_search": {
    "search_context_size": "low",
    "max_candidates_per_batch": 12,
    "collector_max_output_tokens": 4500,
    "json_retries": 2,
    "search_max_output_tokens": 5500
  },
  "dedupe": {
    "title_similarity_threshold": 0.79
  },
  "category_weights": {
    "ai": 1.5,
    "technology": 1.4,
    "space": 1.4,
    "engineering": 1.4,
    "economy": 1.3,
    "chess": 1.3,
    "russia": 1.1,
    "world": 0.8,
    "internet_culture": 1.0
  },
  "soft_targets": {
    "ai_technology": 4,
    "space_engineering": 3,
    "economy": 3,
    "chess": 2,
    "russia": 2,
    "important_world": 1
  },
  "collection_batches": {
    "ai": {
      "search_query": "(\"искусственный интеллект\" OR \"AI model\" OR \"нейросеть\")",
      "category": "ai"
    },
    "space": {
      "search_query": "(космос OR NASA OR ESA OR SpaceX OR астрономия)",
      "category": "space"
    },
    "engineering": {
      "search_query": "(робототехника OR инженерия OR semiconductor OR энергетика)",
      "category": "engineering"
    },
    "science_tech": {
      "search_query": "(технологии OR исследование OR technology OR science)",
      "category": "technology"
    },
    "economy": {
      "search_query": "(экономика OR производство OR инвестиции OR economy)",
      "category": "economy"
    },
    "chess": {
      "search_query": "(шахматы OR FIDE OR chess)",
      "category": "chess"
    },
    "russia_core": {
      "search_query": "(Россия экономика OR Россия технологии OR российское производство)",
      "category": "russia"
    },
    "world_core": {
      "search_query": "(major discovery OR major disaster OR мировая экономика)",
      "category": "world"
    },
    "internet_culture": {
      "search_query": "(\"новый мем\" OR \"мемный тренд\" OR \"viral meme\")",
      "category": "internet_culture"
    }
  },
  "memory": {
    "history_days": 7,
    "max_history_items": 500,
    "rule": "Do not repeat a previously shown story unless there is a material new development."
  },
  "personalization": {
    "enabled": true,
    "storage": "browser_local_storage",
    "hide_threshold": -1.6,
    "category_vote_weight": 0.8,
    "tag_vote_weight": 0.45,
    "max_tags_per_story": 6
  },
  "provider": "rss_plus_openrouter_free",
  "editor_max_output_tokens": 12000,
  "openrouter_free_requests_per_day": 50,
  "publication_mode": "review"
}
